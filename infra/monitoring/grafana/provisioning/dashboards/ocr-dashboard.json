{
  "dashboard": {
    "id": null,
    "uid": null,
    "title": "OCR Performance Dashboard",
    "tags": ["ocr", "performance"],
    "timezone": "browser",
    "panels": [
      {
        "id": 1,
        "title": "OCR Requests",
        "type": "graph",
        "targets": [
          {
            "expr": "rate(ocr_requests_total[1m])",
            "legendFormat": "{{method}}"
          }
        ]
      },
      {
        "id": 2,
        "title": "OCR Processing Time",
        "type": "graph",
        "targets": [
          {
            "expr": "histogram_quantile(0.95, sum(rate(ocr_processing_time_seconds_bucket[5m])) by (le))",
            "legendFormat": "95th percentile"
          }
        ]
      },
      {
        "id": 3,
        "title": "CER/WER Metrics",
        "type": "graph",
        "targets": [
          {
            "expr": "avg(ocr_cer)",
            "legendFormat": "CER"
          },
          {
            "expr": "avg(ocr_wer)",
            "legendFormat": "WER"
          }
        ]
      },
      {
        "id": 4,
        "title": "Success Rate",
        "type": "gauge",
        "targets": [
          {
            "expr": "sum(ocr_success_total) / sum(ocr_requests_total) * 100",
            "legendFormat": "Success %"
          }
        ]
      }
    ],
    "templating": {
      "list": []
    },
    "time": {
      "from": "now-6h",
      "to": "now"
    }
  },
  "overwrite": true
}