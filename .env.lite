# ============================================
# OmniMedical Suite — LITE Mode Configuration
# ============================================
# Minimal configuration for local development and testing
# Services: web + api only (SQLite, no Redis, no monitoring)
# Requirements: 2GB RAM, 1 CPU core

# App
APP_NAME=OmniMedical Suite (Lite)
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# Database — SQLite for lite mode
DATABASE_URL=sqlite:///./data/omnimedical_lite.db
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=omnimedical
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=omnimedical_lite

# Redis — Disabled in lite mode
REDIS_ENABLED=false
REDIS_URL=

# OCR Configuration
OCR_ENGINE=paddleocr
OCR_LANGUAGES=en,ar
OCR_DEVICE=cpu
OCR_BATCH_SIZE=1

# Medical Protection (minimal)
ENABLE_MEDICAL_PROTECTION=true
PROTECTION_STRICTNESS=medium

# API
WORKERS=1
MAX_UPLOAD_SIZE=10MB
API_RATE_LIMIT=60/minute

# Web
NEXTAUTH_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# Disable optional services
CELERY_ENABLED=false
QDRANT_ENABLED=false
MONITORING_ENABLED=false
