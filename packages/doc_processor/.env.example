# Medical Document Processor - Environment Variables
# Copy this file to .env.local and fill in your values
# NEVER commit .env or .env.local to Git

# Database (SQLite)
DATABASE_URL="file:./db/custom.db"

# NextAuth.js
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET=""  # Generate with: openssl rand -base64 32

# Optional: Mistral AI for OCR
MISTRAL_API_KEY=""  # Get from https://console.mistral.ai/

# Optional: Admin seed password (used only on first setup)
# MUST be set to a real, strong password before invoking /api/auth/seed.
# The seed endpoint refuses to run if this is empty or shorter than 12 chars.
ADMIN_SEED_PASSWORD=""  # Set this to a 12+ char strong password before seeding
