# Medical Document Processor - Environment Variables
# Copy this file to .env.local and fill in your values
# NEVER commit .env or .env.local to Git

# Database (SQLite)
DATABASE_URL="file:./db/custom.db"

# NextAuth.js
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET=""  # Generate with: openssl rand -base64 32

# Optional: Mistral AI for OCR
MISTRAL_API_KEY=""  # Get from https://console.mistral.ai/

# Optional: Admin seed password (used only on first setup)
ADMIN_SEED_PASSWORD="admin123"  # CHANGE THIS IN PRODUCTION!
