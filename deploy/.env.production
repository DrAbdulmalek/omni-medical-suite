# =============================================================================
# Omni Medical Suite — Production Environment Variables
# =============================================================================
# Copy to .env and fill in ALL CHANGE_ME values before deploying.
#   cp .env.production .env
#
# Generate secrets:
#   openssl rand -hex 32    (for passwords/keys)
#   openssl rand -base64 32 (for auth secrets)
#
# ⚠️ NEVER commit this file with real values to Git!
# =============================================================================

# ── Domain & SSL ──────────────────────────────────────────────────────────────
DOMAIN=your-domain.com
EMAIL=admin@your-domain.com

# ── Application ──────────────────────────────────────────────────────────────
APP_NAME=omni-medical-suite
APP_ENV=production
APP_DEBUG=false
APP_SECRET_KEY=CHANGE_ME_openssl_rand_hex_32
APP_LOG_LEVEL=INFO
APP_PORT=8000

# ── Database (PostgreSQL 15) ────────────────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=omni_medical
POSTGRES_USER=omni_user
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD_32_CHARS
POSTGRES_POOL_SIZE=20
POSTGRES_MAX_OVERFLOW=10
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# ── Redis 7 ──────────────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
REDIS_URL=redis://:${REDIS_PASSWORD}@${REDIS_HOST}:${REDIS_PORT}/${REDIS_DB}

# ── Qdrant (Vector Database) ────────────────────────────────────────────────
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_COLLECTION=medical_documents
QDRANT_URL=http://${QDRANT_HOST}:${QDRANT_PORT}

# ── Celery (Background Tasks) ────────────────────────────────────────────────
CELERY_BROKER_URL=${REDIS_URL}
CELERY_RESULT_BACKEND=redis://:${REDIS_PASSWORD}@${REDIS_HOST}:${REDIS_PORT}/1
CELERY_TASK_SERIALIZER=json
CELERY_RESULT_SERIALIZER=json
CELERY_ACCEPT_CONTENT=json
CELERY_WORKER_PREFETCH_MULTIPLIER=4
CELERY_TASK_TIME_LIMIT=300
CELERY_TASK_SOFT_TIME_LIMIT=240
CELERY_BEAT_SCHEDULE=true

# ── Authentication ───────────────────────────────────────────────────────────
JWT_SECRET_KEY=CHANGE_ME_JWT_SECRET_openssl_rand_hex_32
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
NEXTAUTH_SECRET=CHANGE_ME_NEXTAUTH_SECRET_openssl_rand_base64_32
NEXTAUTH_URL=https://${DOMAIN}
CORS_ORIGINS=["https://${DOMAIN}"]
AUTH_ALLOWED_ORIGINS=https://${DOMAIN}

# ── Admin ────────────────────────────────────────────────────────────────────
# Generate: node -e "console.log(require('bcrypt').hashSync('your-password', 10))"
ADMIN_PASSWORD_HASH=

# ── Encryption ───────────────────────────────────────────────────────────────
# AES-256-GCM key (32 bytes, base64)
ENCRYPTION_KEY=CHANGE_ME_ENCRYPTION_KEY_openssl_rand_base64_32

# ── OCR Engine ───────────────────────────────────────────────────────────────
OCR_ENGINE_ORDER=mixed_engine,tesseract,easyocr
OCR_ENGINE=tesseract
TESSERACT_LANGUAGES=ara+eng
OCR_DEVICE=cpu
OCR_BATCH_SIZE=8
OCR_CONFIDENCE_THRESHOLD=0.7
EASYOCR_GPU=false

# ── Medical OCR Postprocessor ────────────────────────────────────────────────
POSTPROCESSOR_ENABLED=true
POSTPROCESSOR_PHI_MASKING=true
POSTPROCESSOR_PHI_MODE=tag
POSTPROCESSOR_CONFIDENCE_THRESHOLD=0.85
POSTPROCESSOR_DICTIONARY_PATH=/app/data/dictionaries/medical_dict.csv

# ── AI / LLM Integration (Optional) ────────────────────────────────────────
MISTRAL_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_AI_API_KEY=
AI_API_KEY=
AI_MODEL=gpt-4o
AI_TEMPERATURE=0.1
AI_MAX_TOKENS=4096
AI_TIMEOUT=30

# ── Medical Context Protection ───────────────────────────────────────────────
ENABLE_MEDICAL_PROTECTION=true
PROTECTION_STRICTNESS=high

# ── Auto Promotion ───────────────────────────────────────────────────────────
AUTO_PROMOTION_ENABLED=true
PROMOTION_FREQUENCY_THRESHOLD=3
PROMOTION_CONFIDENCE_GAIN=0.05
PROMOTION_MAX_AGE_DAYS=30

# ── OCR Fusion ───────────────────────────────────────────────────────────────
FUSION_SPATIAL_EPS=15.0
FUSION_MIN_CONFIDENCE=0.55

# ── File Handling ────────────────────────────────────────────────────────────
MAX_FILE_SIZE_MB=50
MAX_UPLOAD_SIZE=50MB
UPLOAD_DIR=/app/uploads
ENCRYPTED_DIR=/app/encrypted
ALLOWED_FILE_TYPES=pdf,png,jpg,jpeg,tiff,bmp,docx

# ── Rate Limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_TIER_FREE=10
RATE_LIMIT_TIER_STANDARD=100
RATE_LIMIT_TIER_PREMIUM=500
OCR_CACHE_TTL=86400

# ── Circuit Breaker ──────────────────────────────────────────────────────────
CIRCUIT_BREAKER_ENABLED=true

# ── Medical Validator ────────────────────────────────────────────────────────
MEDICAL_VALIDATOR_ENABLED=true

# ── FHIR ────────────────────────────────────────────────────────────────────
FHIR_DEFAULT_FORMAT=fhir_r4

# ── Monitoring ───────────────────────────────────────────────────────────────
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090
GRAFANA_PASSWORD=CHANGE_ME_GRAFANA_PASSWORD
SENTRY_DSN=

# ── PHI Compliance ──────────────────────────────────────────────────────────
PHI_DETECTION_ENABLED=true
PHI_AUDIT_LOG_ENABLED=true
PHI_RETENTION_DAYS=2555
PHI_ENCRYPTION_ENABLED=true

# ── Docker ───────────────────────────────────────────────────────────────────
DOCKER_REGISTRY=ghcr.io
DOCKER_IMAGE_PREFIX=drabdulmalek/omni-medical-suite
COMPOSE_PROJECT_NAME=omni-suite
