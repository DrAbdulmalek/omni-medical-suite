# =============================================================================
# Omni Medical Suite — Production Dockerfile (Gradio HITL Interface)
# =============================================================================
FROM python:3.11-slim AS builder

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential gcc g++ cmake libpq-dev git \
    tesseract-ocr tesseract-ocr-ara tesseract-ocr-eng \
    libgl1 libglib2.0-0 libsm6 libxext6 libxrender-dev \
    && rm -rf /var/lib/apt/lists/*

RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"
WORKDIR /build

COPY requirements/base.txt ./requirements/base.txt
COPY requirements/api.txt ./requirements/api.txt
COPY requirements/ml.txt ./requirements/ml.txt
COPY requirements/gradio.txt ./requirements/gradio.txt
# requirements/ml.txt contains an editable local dependency. Copy that package
# into the builder before pip resolves requirements so the path exists.
COPY packages/scanner_fixer ./packages/scanner_fixer

RUN pip install --no-cache-dir --upgrade pip setuptools wheel && \
    pip install --no-cache-dir -r requirements/gradio.txt && \
    pip install --no-cache-dir asyncpg uvloop httptools

RUN PYTHONPATH=/opt/venv/lib/python3.11/site-packages \
    python -c "from paddleocr import PaddleOCR; PaddleOCR(use_angle_cls=True, lang='ar', show_log=False)" || true

FROM python:3.11-slim AS production

LABEL maintainer="Dr. Abdulmalek Al-husseini"
LABEL description="Omni Medical Suite - Gradio HITL Interface (Production)"
LABEL version="2.2.0"
LABEL org.opencontainers.image.source="https://github.com/DrAbdulmalek/omni-medical-suite"

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PATH="/opt/venv/bin:$PATH" \
    PYTHONPATH=/app

RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq5 curl tesseract-ocr tesseract-ocr-ara tesseract-ocr-eng \
    libgl1 libglib2.0-0 libtesseract-dev libleptonica-dev \
    libsm6 libxext6 libxrender-dev poppler-utils \
    && rm -rf /var/lib/apt/lists/*

RUN tesseract --version && tesseract --list-langs
RUN groupadd -r omni && useradd -r -g omni -u 1000 -m -d /app omni
RUN mkdir -p /app/uploads /app/results /app/logs /app/data /app/encrypted /app/model /app/backups && \
    chown -R omni:omni /app

WORKDIR /app
COPY --from=builder /opt/venv /opt/venv
COPY --chown=omni:omni . .
RUN chmod +x /app/deploy/docker-entrypoint.sh

USER omni
EXPOSE 7860
HEALTHCHECK --interval=30s --timeout=10s --start-period=120s --retries=3 \
    CMD curl -f http://localhost:7860/ || exit 1

ENTRYPOINT ["/app/deploy/docker-entrypoint.sh"]
CMD ["python", "deploy/gradio_launcher.py"]
