# STATUS: TEMPLATE ONLY — NOT EXECUTED
# PHASE: V-2
# TESTED: NO
# Replace {{DOMAIN}} with your actual domain.
# Security notes (review before execution):
#   * upstream services stay on 127.0.0.1 — never expose 5000/5001 directly
#   * add limit_req_zone/limit_req before production (SECURITY_CHECKLIST)
#   * for Socket.IO (/socket.io/) add: proxy_http_version 1.1;
#     proxy_set_header Upgrade $http_upgrade; proxy_set_header Connection "upgrade";

server {
    listen 80;
    server_name {{DOMAIN}};

    client_max_body_size 100M;

    location / {
        proxy_pass http://127.0.0.1:5000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_read_timeout 300s;
    }
}
