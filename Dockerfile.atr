# =============================================================================
# Dockerfile.atr — حزمة AHW (ATR phase) — خادم التصحيح + واجهة التدريب
# =============================================================================
# ملاحظات حوكمة (موثقة في docs/atr/ و PROGRESS.md):
#   * لا يستبدل Dockerfile الجذري للمنظومة القائمة — هذا ملف ATR منفصل.
#   * الانحراف عن نص المواصفة: libgl1 بدل libgl1-mesa-glx — الاسم القديم
#     غير متاح في Debian bookworm (أساس python:3.10-slim الحالي) ويسبب فشل
#     البناء؛ libgl1 هو بديله الرسمي.
#   * المتطلبات من requirements-atr.txt المخصص (خفيف) وليس requirements.txt
#     الجذري الثقيل الخاص بالمنظومة الكاملة.
# البناء:  docker build -f Dockerfile.atr -t ahw-atr .
# =============================================================================
FROM python:3.10-slim

# متطلبات النظام (OpenCV/Pillow + أدوات PDF)
RUN apt-get update && apt-get install -y --no-install-recommends \
    libgl1 \
    libglib2.0-0 \
    poppler-utils \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# تثبيت متطلبات Python أولًا (طبقة cache مستقرة)
COPY requirements-atr.txt .
RUN pip install --no-cache-dir -r requirements-atr.txt

# نسخ كود AHW فقط (سياق البناء = جذر المستودع؛ الإقصاءات في
# Dockerfile.atr.dockerignore — لا يلمس .dockerignore الجذري القائم)
COPY ahw/ ./ahw/
COPY templates/ ./templates/
COPY segment_batch.py merge_batches.py train_server.py correction_server.py ./

# مجلدات المخرجات والأوزان (volumes في compose)
RUN mkdir -p output models

EXPOSE 5000 5001

# الافتراضي: خادم التصحيح (ATR spec: CMD = server.py → معادله correction_server.py)
CMD ["python", "correction_server.py", "--host", "0.0.0.0", "--port", "5000"]
