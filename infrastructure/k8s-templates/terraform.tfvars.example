# OmniMedical Suite v2.0 — Terraform Variables (Copy to terraform.tfvars)

aws_region = "us-east-1"
environment = "staging"
project_name = "omnimedical"

# VPC
vpc_cidr = "10.0.0.0/16"
private_subnet_cidrs = ["10.0.1.0/24", "10.0.2.0/24", "10.0.3.0/24"]
public_subnet_cidrs  = ["10.0.101.0/24", "10.0.102.0/24", "10.0.103.0/24"]

# EKS Nodes
node_desired_size = 3
node_min_size     = 2
node_max_size     = 10
node_instance_types = ["m6i.xlarge"]

# GPU Nodes (for ML inference)
gpu_node_desired_size = 0
gpu_node_min_size     = 0
gpu_node_max_size     = 2

# Database
db_instance_class       = "db.t3.medium"
db_allocated_storage    = 50
db_max_allocated_storage = 500
# db_password = "change-me-in-production"  # Use AWS Secrets Manager or environment variable

# Cache
cache_node_type = "cache.t3.micro"
# cache_auth_token = "change-me-in-production"  # Use AWS Secrets Manager or environment variable
