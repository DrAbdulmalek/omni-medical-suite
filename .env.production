# ============================================
# OmniMedical Suite — PRODUCTION Mode Configuration
# ============================================
# Full production deployment with all services
# Services: web, api, worker, beat, postgres, redis, qdrant, nginx, prometheus, grafana, tempo, lb, ws
# Requirements: 16GB+ RAM, 8+ CPU cores

# ⚠️ SECURITY: Change ALL passwords and secrets before deploying!

# App
APP_NAME=OmniMedical Suite
APP_ENV=production
DEBUG=false
LOG_LEVEL=WARNING

# Database — PostgreSQL (Managed recommended)
DATABASE_URL=postgresql://omnimedical:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:5432/omnimedical
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=omnimedical
POSTGRES_PASSWORD=CHANGE_ME_GENERATE_WITH_OPENSSL
POSTGRES_DB=omnimedical
POSTGRES_POOL_SIZE=20
POSTGRES_MAX_OVERFLOW=10

# Redis — Production config with persistence
REDIS_ENABLED=true
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379/0
REDIS_PASSWORD=CHANGE_ME_GENERATE_WITH_OPENSSL

# Celery
CELERY_ENABLED=true
CELERY_BROKER_URL=redis://:${REDIS_PASSWORD}@redis:6379/1
CELERY_RESULT_BACKEND=redis://:${REDIS_PASSWORD}@redis:6379/2
CELERY_WORKERS=4
CELERY_BEAT_ENABLED=true

# Qdrant
QDRANT_ENABLED=true
QDRANT_HOST=qdrant
QDRANT_PORT=6333

# OCR
OCR_ENGINE=ensemble
OCR_LANGUAGES=en,ar
OCR_DEVICE=cuda
OCR_BATCH_SIZE=8

# Medical Protection
ENABLE_MEDICAL_PROTECTION=true
PROTECTION_STRICTNESS=high
PHI_MASKING_ENABLED=true
PHI_AUDIT_ENABLED=true
PHI_RETENTION_DAYS=2555

# Security
JWT_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL
AES_ENCRYPTION_KEY=CHANGE_ME_32_BYTE_KEY
NEXTAUTH_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL
CORS_ORIGINS=https://yourdomain.com

# API
WORKERS=4
MAX_UPLOAD_SIZE=100MB
API_RATE_LIMIT=300/minute

# Monitoring
MONITORING_ENABLED=true
SENTRY_DSN=

# Web
NEXTAUTH_URL=https://yourdomain.com
NEXT_PUBLIC_API_URL=https://yourdomain.com/api
