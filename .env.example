# =============================================================================
# OmniMedical Suite v2.0 — Unified Environment Configuration
# =============================================================================
# Copy this file to .env and fill in the values.
#   cp .env.example .env
#
# Generate secrets with:  openssl rand -base64 32
# For production secrets: make secrets  (runs scripts/generate-secrets.sh)
#
# For production-specific variables, see: env.example.production
# =============================================================================

# ─── Application ──────────────────────────────────────────────────────────
# Application environment: development | production
NODE_ENV=development

# Application name used in monitoring and logging
APP_NAME=omni-medical-suite

# Whether to enable debug mode (verbose logging, stack traces)
APP_DEBUG=true

# Application secret key (general-purpose, generate with: openssl rand -base64 32)
APP_SECRET_KEY=CHANGE_ME_GENERATE_WITH_SCRIPTS

# Application log level: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# Application port (Python backend)
APP_PORT=8000

# ─── Database ─────────────────────────────────────────────────────────────
# Prisma DATABASE_URL
#   Development (SQLite):    file:/data/dev.db
#   Production (PostgreSQL): postgresql://user:pass@host:5432/db
DATABASE_URL=file:/data/dev.db

# PostgreSQL connection (used by docker-compose.prod.yml)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=medical_ocr
POSTGRES_USER=medocr
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_POOL_SIZE=20
POSTGRES_MAX_OVERFLOW=10

# ─── Redis ────────────────────────────────────────────────────────────────
# Redis connection URL (used for caching, rate limiting, Celery broker)
REDIS_URL=redis://redis:6379/0

# Redis host and port (used by docker-compose.prod.yml)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
# Redis password (required in production)
REDIS_PASSWORD=

# ─── NextAuth (Web Frontend Authentication) ────────────────────────────────
# REQUIRED for authentication. Generate with: openssl rand -base64 32
# REQUIRED: Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=

# Public URL of the Next.js application
NEXTAUTH_URL=http://localhost:3000

# Admin password hash (bcrypt). Generate with:
#   node -e "console.log(require('bcrypt').hashSync('your-password', 10))"
ADMIN_PASSWORD_HASH=

# ─── Security ─────────────────────────────────────────────────────────────
# AES-256-GCM encryption key (32 bytes, base64-encoded)
# REQUIRED: Generate with: openssl rand -base64 32
ENCRYPTION_KEY=

# JWT secret key (generate with: openssl rand -base64 32)
JWT_SECRET_KEY=CHANGE_ME_JWT_SECRET

# JWT algorithm: HS256 | HS384 | HS512
JWT_ALGORITHM=HS256

# JWT access token expiry (minutes)
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# JWT refresh token expiry (days)
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Allowed CORS origins (JSON array format)
AUTH_ALLOWED_ORIGINS=http://localhost:3000

# ─── OCR Engine ──────────────────────────────────────────────────────────
# OCR engine priority chain (comma-separated, first match wins)
OCR_ENGINE_ORDER=mixed_engine,tesseract,mistral,easyocr

# Tesseract language packs (plus-separated)
TESSERACT_LANGUAGES=ara+eng

# Default OCR engine (single engine mode)
OCR_ENGINE=tesseract

# OCR device: cpu | cuda | mps
OCR_DEVICE=cpu

# OCR batch size for parallel processing
OCR_BATCH_SIZE=8

# Minimum confidence threshold for OCR results (0.0–1.0)
OCR_CONFIDENCE_THRESHOLD=0.7

# Enable GPU acceleration for EasyOCR
EASYOCR_GPU=false

# ─── Mistral AI ───────────────────────────────────────────────────────────
# Mistral API key for cloud-based OCR
MISTRAL_API_KEY=

# Mistral model to use for OCR
MISTRAL_MODEL=mistral-ocr-latest

# ─── NLP Pipeline ─────────────────────────────────────────────────────────
# Active NLP pipeline stages (comma-separated)
NLP_STAGES=preprocessing,correction,entity_extraction,enrichment

# Default NLP processing language: ar | en | auto
NLP_LANGUAGE=ar

# Enable PII detection and masking in NLP pipeline
ENABLE_PII_DETECTION=true

# ─── AI / LLM Integration ───────────────────────────────────────────────
# OpenAI API key (for AI-assisted correction)
OPENAI_API_KEY=

# OpenAI model for AI correction
OPENAI_MODEL=gpt-4o

# Anthropic API key
ANTHROPIC_API_KEY=

# Google AI API key (Gemini)
GOOGLE_AI_API_KEY=

# Generic AI API key (fallback)
AI_API_KEY=

# AI model for generic integration
AI_MODEL=gpt-4

# AI temperature (0.0–1.0, lower = more deterministic)
AI_TEMPERATURE=0.1

# AI max tokens per request
AI_MAX_TOKENS=4096

# AI request timeout (seconds)
AI_TIMEOUT=30

# ─── Medical Context Protection ───────────────────────────────────────────
# Enable medical context protection (prevents merging distinct medical info)
ENABLE_MEDICAL_PROTECTION=true

# Protection strictness: low | medium | high
PROTECTION_STRICTNESS=high

# ─── Medical OCR Postprocessor ────────────────────────────────────────────
# Enable the medical OCR postprocessor
POSTPROCESSOR_ENABLED=true

# Enable PHI (Protected Health Information) masking
POSTPROCESSOR_PHI_MASKING=true

# PHI masking mode: tag | mask | remove
POSTPROCESSOR_PHI_MODE=tag

# Postprocessor confidence threshold (0.0–1.0)
POSTPROCESSOR_CONFIDENCE_THRESHOLD=0.85

# Path to medical dictionary CSV
POSTPROCESSOR_DICTIONARY_PATH=/app/data/dictionaries/medical_dict.csv

# ─── Auto Promotion ───────────────────────────────────────────────────────
# Enable auto-promotion of corrections from review queue
AUTO_PROMOTION_ENABLED=true

# Minimum frequency threshold for auto-promotion
PROMOTION_FREQUENCY_THRESHOLD=3

# Minimum confidence gain for auto-promotion
PROMOTION_CONFIDENCE_GAIN=0.05

# Maximum age (days) for auto-promotion eligibility
PROMOTION_MAX_AGE_DAYS=30

# ─── OCR Fusion ───────────────────────────────────────────────────────────
# Spatial epsilon for DBSCAN clustering in fusion V2
FUSION_SPATIAL_EPS=15.0

# Minimum confidence for fusion voting
FUSION_MIN_CONFIDENCE=0.55

# ─── Qdrant (Vector Database) ────────────────────────────────────────────
# Qdrant host and port
QDRANT_HOST=qdrant
QDRANT_PORT=6333

# Qdrant collection name for medical document embeddings
QDRANT_COLLECTION=medical_documents

# Qdrant API key (optional, for managed Qdrant instances)
QDRANT_API_KEY=

# ─── Celery (Background Tasks) ───────────────────────────────────────────
# Celery broker URL (defaults to REDIS_URL)
CELERY_BROKER_URL=redis://redis:6379/0

# Celery result backend URL
CELERY_RESULT_BACKEND=redis://redis:6379/1

# Celery task serialization format
CELERY_TASK_SERIALIZER=json

# Celery result serialization format
CELERY_RESULT_SERIALIZER=json

# Celery accepted content types
CELERY_ACCEPT_CONTENT=json

# Celery worker prefetch multiplier
CELERY_WORKER_PREFETCH_MULTIPLIER=4

# Celery hard time limit per task (seconds)
CELERY_TASK_TIME_LIMIT=300

# Celery soft time limit per task (seconds)
CELERY_TASK_SOFT_TIME_LIMIT=240

# Enable Celery beat scheduler
CELERY_BEAT_SCHEDULE=true

# ─── Training ─────────────────────────────────────────────────────────────
# Training algorithm: knn | active_learning | trocr
TRAINING_ALGORITHM=knn

# Number of neighbors for KNN training
TRAINING_K_NEIGHBORS=5

# ─── File Handling ───────────────────────────────────────────────────────
# Maximum upload file size (MB)
MAX_FILE_SIZE_MB=50
MAX_UPLOAD_SIZE=50MB

# Uploaded files directory
UPLOAD_DIR=./uploads

# Encrypted files directory
ENCRYPTED_DIR=./encrypted

# Allowed file types for upload (comma-separated)
ALLOWED_FILE_TYPES=pdf,png,jpg,jpeg,tiff,bmp,docx

# ─── Rate Limiting ───────────────────────────────────────────────────────
# Rate limiting window (milliseconds)
RATE_LIMIT_WINDOW_MS=60000

# Max requests per rate-limit window
RATE_LIMIT_MAX_REQUESTS=100

# Rate limit tier: free
RATE_LIMIT_TIER_FREE=10

# Rate limit tier: standard
RATE_LIMIT_TIER_STANDARD=100

# Rate limit tier: premium
RATE_LIMIT_TIER_PREMIUM=500

# OCR cache TTL (seconds)
OCR_CACHE_TTL=86400

# ─── Circuit Breaker ───────────────────────────────────────────────────────
# Enable circuit breaker for external services
CIRCUIT_BREAKER_ENABLED=true

# ─── Medical Validator ────────────────────────────────────────────────────
# Enable medical term validation
MEDICAL_VALIDATOR_ENABLED=true

# ─── FHIR ────────────────────────────────────────────────────────────────
# Default FHIR output format
FHIR_DEFAULT_FORMAT=fhir_r4

# ─── Grafana ──────────────────────────────────────────────────────────────
# Grafana admin password
# REQUIRED: Generate with: openssl rand -base64 32
GRAFANA_PASSWORD=

# ─── Monitoring ──────────────────────────────────────────────────────────
# Enable Prometheus metrics collection
PROMETHEUS_ENABLED=true

# Prometheus port
PROMETHEUS_PORT=9090

# Sentry DSN (optional, for error tracking)
SENTRY_DSN=

# ─── PHI Compliance ───────────────────────────────────────────────────────
# Enable PHI detection
PHI_DETECTION_ENABLED=true

# Enable PHI audit logging
PHI_AUDIT_LOG_ENABLED=true

# PHI retention period (days, default 7 years)
PHI_RETENTION_DAYS=2555

# Enable PHI encryption at rest
PHI_ENCRYPTION_ENABLED=true

# ─── Docker ───────────────────────────────────────────────────────────────
# Docker registry for image pushes
DOCKER_REGISTRY=ghcr.io

# Docker image name prefix
DOCKER_IMAGE_PREFIX=drabdulmalek/omni-medical-suite

# Docker Compose project name
COMPOSE_PROJECT_NAME=omni-suite

# ─── Kubernetes ───────────────────────────────────────────────────────────
# Kubernetes namespace
K8S_NAMESPACE=omni-medical

# Number of API replicas
K8S_REPLICAS_API=3

# Number of worker replicas
K8S_REPLICAS_WORKER=2

# CPU request per pod
K8S_RESOURCE_CPU_REQUEST=500m

# CPU limit per pod
K8S_RESOURCE_CPU_LIMIT=2000m

# Memory request per pod
K8S_RESOURCE_MEMORY_REQUEST=512Mi

# Memory limit per pod
K8S_RESOURCE_MEMORY_LIMIT=2Gi
