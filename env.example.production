# ============================================
# OmniMedical Suite — Production Environment
# ============================================
# Copy this file to .env.production and fill in real values.
# NEVER commit .env.production to version control.
# Usage: docker compose --env-file .env.production up -d

# ---- Application ----
APP_ENV=production
APP_URL=https://your-domain.com
APP_PORT=8000
APP_LOG_LEVEL=warning

# ---- Next.js Frontend ----
NEXT_PUBLIC_APP_URL=https://your-domain.com
NEXT_PUBLIC_API_URL=https://api.your-domain.com

# ---- Database (PostgreSQL — REQUIRED for production) ----
DATABASE_URL=postgresql://omnimed_user:CHANGE_ME_STRONG_PASSWORD@db_host:5432/omnimed_prod
DATABASE_POOL_MIN=5
DATABASE_POOL_MAX=20

# ---- Redis ----
REDIS_URL=redis://:CHANGE_ME_REDIS_PASSWORD@redis_host:6379/0

# ---- Celery ----
CELERY_BROKER_URL=redis://:CHANGE_ME_REDIS_PASSWORD@redis_host:6379/1
CELERY_RESULT_BACKEND=redis://:CHANGE_ME_REDIS_PASSWORD@redis_host:6379/2

# ---- Qdrant Vector Database ----
QDRANT_URL=http://qdrant_host:6333
QDRANT_API_KEY=your-qdrant-api-key
QDRANT_COLLECTION=medical_documents

# ---- Authentication (NextAuth) ----
NEXTAUTH_SECRET=CHANGE_ME_NEXTAUTH_SECRET_MIN_32_CHARS
NEXTAUTH_URL=https://your-domain.com

# ---- Encryption ----
AES_ENCRYPTION_KEY=CHANGE_ME_32_BYTE_AES_KEY_HEX

# ---- OCR Engines ----
TESSERACT_PATH=/usr/bin/tesseract
PADDLEOCR_USE_GPU=false
EASYOCR_GPU=false

# ---- AI Models ----
MISTRAL_API_KEY=your-mistral-api-key
OPENAI_API_KEY=your-openai-api-key

# ---- Monitoring ----
PROMETHEUS_PORT=9090
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_GRAFANA_PASSWORD

# ---- Rate Limiting ----
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_BURST=10

# ---- MinIO / S3 Storage ----
MINIO_ENDPOINT=minio_host:9000
MINIO_ACCESS_KEY=CHANGE_ME_MINIO_ACCESS_KEY
MINIO_SECRET_KEY=CHANGE_ME_MINIO_SECRET_KEY
MINIO_BUCKET=medical-documents
MINIO_USE_SSL=true
