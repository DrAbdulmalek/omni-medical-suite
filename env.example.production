# =============================================================================
# Omni Medical Suite — Production Environment Variables
# =============================================================================
# Copy this file to .env.production and fill in actual values.
# NEVER commit the actual .env file to version control.
# Usage: cp env.example.production .env.production
# =============================================================================

# ---- Operating Mode --------------------------------------------------------
# lite            : Minimal deployment — API only, no GPU, no ML workers.
#                   Suitable for small clinics or testing.
#
# standard        : Full deployment — API + Celery workers + PostgreSQL + Redis.
#                   CPU-based OCR (Tesseract / PaddleOCR). No GPU required.
#
# gpu-production  : Full deployment with GPU — same as standard but enables
#                   GPU-accelerated OCR (Surya, custom models) and optional
#                   HTR (handwriting recognition). Requires NVIDIA GPU + drivers.
# ---------------------------------------------------------------------------
MODE=lite

# ---- Application -----------------------------------------------------------
APP_NAME=omni-medical-suite
APP_ENV=production
APP_DEBUG=false
APP_SECRET_KEY=<PLACEHOLDER_GENERATE_WITH_openssl_rand_hex_32>
APP_LOG_LEVEL=INFO
APP_PORT=8000

# ---- Database (PostgreSQL) -------------------------------------------------
DB_USER=omni_user
DB_PASSWORD=<PLACEHOLDER_STRONG_PASSWORD>
DB_NAME=omni_medical
DB_HOST=postgres
DB_PORT=5432
DB_URL=postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# ---- Redis -----------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=<PLACEHOLDER_REDIS_PASSWORD>
REDIS_URL=redis://:${REDIS_PASSWORD}@${REDIS_HOST}:${REDIS_PORT}/${REDIS_DB}

# ---- Security --------------------------------------------------------------
SECRET_KEY=<PLACEHOLDER_GENERATE_WITH_openssl_rand_hex_32>
JWT_SECRET_KEY=<PLACEHOLDER_JWT_SECRET>
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ---- OCR Engine Configuration ----------------------------------------------
# Options: tesseract, easyocr, paddleocr, surya
# For gpu-production MODE, set OCR_DEVICE=cuda
OCR_ENGINE=tesseract
OCR_LANGUAGES=en,ar
OCR_DEVICE=cpu
OCR_BATCH_SIZE=8
OCR_CONFIDENCE_THRESHOLD=0.7

# ---- Celery (Background Tasks) ---------------------------------------------
CELERY_BROKER_URL=${REDIS_URL}
CELERY_RESULT_BACKEND=${REDIS_URL}
CELERY_TASK_SERIALIZER=json
CELERY_RESULT_SERIALIZER=json
CELERY_ACCEPT_CONTENT=json
CELERY_WORKER_PREFETCH_MULTIPLIER=4
CELERY_TASK_TIME_LIMIT=300
CELERY_TASK_SOFT_TIME_LIMIT=240

# ---- Monitoring (Optional) -------------------------------------------------
# Set to true to enable Prometheus metrics endpoint at /metrics
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090

# Grafana URL for dashboards (set after deploying monitoring stack)
GRAFANA_URL=http://localhost:3001

# ---- CORS & Security -------------------------------------------------------
CORS_ORIGINS=["https://your-domain.com"]
CORS_ALLOW_CREDENTIALS=false
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD=60
MAX_UPLOAD_SIZE_MB=50
ALLOWED_FILE_TYPES=pdf,png,jpg,jpeg,tiff,bmp,docx

# ---- PHI Compliance --------------------------------------------------------
PHI_DETECTION_ENABLED=true
PHI_AUDIT_LOG_ENABLED=true
PHI_RETENTION_DAYS=2555
PHI_ENCRYPTION_ENABLED=true