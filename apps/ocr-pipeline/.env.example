# HuggingFace Token (for downloading gated models like Jais)
HF_TOKEN=hf_your_token_here

# Tesseract data path (leave default if installed system-wide)
TESSDATA_PREFIX=/usr/share/tesseract-ocr/4.00/tessdata/

# Device selection: cpu / cuda / auto
DEVICE=auto

# TrOCR model path (local fine-tuned model)
TROCR_MODEL_PATH=./trocr_medical_arabic

# Jais model name
JAIS_MODEL_NAME=instructlab/merlinite-7b

# Enable 8-bit quantization for LLM (reduces VRAM)
USE_8BIT=true