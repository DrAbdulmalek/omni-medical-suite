# ============================================
# OmniMedical Suite — STANDARD Mode Configuration
# ============================================
# For small teams and staging environments
# Services: web, api, worker, postgres, redis, qdrant, monitoring
# Requirements: 8GB RAM, 2-4 CPU cores

# App
APP_NAME=OmniMedical Suite (Standard)
APP_ENV=staging
DEBUG=false
LOG_LEVEL=INFO

# Database — PostgreSQL for standard mode
DATABASE_URL=postgresql://omnimedical:CHANGE_ME_STRONG_PASSWORD@localhost:5432/omnimedical
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=omnimedical
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=omnimedical

# Redis
REDIS_ENABLED=true
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=

# Celery (async tasks)
CELERY_ENABLED=true
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Qdrant (vector search)
QDRANT_ENABLED=true
QDRANT_HOST=localhost
QDRANT_PORT=6333

# OCR Configuration
OCR_ENGINE=ensemble
OCR_LANGUAGES=en,ar
OCR_DEVICE=cpu
OCR_BATCH_SIZE=4

# Medical Protection
ENABLE_MEDICAL_PROTECTION=true
PROTECTION_STRICTNESS=high
PHI_MASKING_ENABLED=true

# API
WORKERS=2
MAX_UPLOAD_SIZE=50MB
API_RATE_LIMIT=120/minute

# Monitoring
MONITORING_ENABLED=true
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001

# Web
NEXTAUTH_SECRET=CHANGE_ME_USE_OPENSSL_RAND
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
