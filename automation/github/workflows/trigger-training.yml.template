permissions:
  contents: read

jobs:
  trigger:
    runs-on: ubuntu-latest
    steps:
      - name: Show latest dataset (no decryption — encrypted assets only)
        run: |
          echo "Dataset tag input: ${{ inputs.dataset_tag || 'latest' }}"
          echo "Open the Colab notebook (automation/colab/train_arabic_trocr.ipynb.template"
          echo "materialized in the private notebooks environment) and run cells 1-10."
      - name: Reminder gates
        run: |
          echo "Gates: SHA256 verify after pull · synthetic-first policy · no PHI logging"
